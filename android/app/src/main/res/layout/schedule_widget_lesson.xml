<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lesson_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingVertical="4dp">
    <TextView android:id="@+id/widget_lesson_number" android:layout_width="26dp" android:layout_height="wrap_content"
        android:textColor="@color/widget_accent" android:textSize="14sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_lesson_subject" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/widget_text" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_lesson_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/widget_secondary" android:textSize="8sp" />
        <TextView android:id="@+id/widget_lesson_room" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/widget_secondary" android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>
