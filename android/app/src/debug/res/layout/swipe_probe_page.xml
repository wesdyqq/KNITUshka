<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_probe_page"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <!-- The unrotated list row is H × W; only the W × H content is counter-rotated. -->
    <FrameLayout android:id="@+id/swipe_probe_page_viewport"
        android:layout_width="match_parent" android:layout_height="240dp">
        <LinearLayout android:id="@+id/swipe_probe_body"
            android:layout_width="240dp" android:layout_height="240dp"
            android:layout_gravity="center" android:rotation="90"
            android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:paddingTop="12dp" android:paddingBottom="6dp"
            android:background="@drawable/widget_background">
            <include layout="@layout/widget_header" />
            <LinearLayout android:id="@+id/swipe_probe_lessons"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:orientation="vertical" />
            <TextView android:id="@+id/swipe_probe_hint"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingHorizontal="8dp" android:textColor="@color/widget_secondary" android:textSize="8sp" />
            <ImageView android:id="@+id/swipe_probe_dots"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:scaleType="centerInside" android:contentDescription="Дни недели" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
